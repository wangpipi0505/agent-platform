{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:agent-platform:graph:1.0","title":"Graph definition v1.0","type":"object",
 "required":["definitionVersion","trigger","entry","nodes","edges","joins","executionRules"],
 "properties":{
  "definitionVersion":{"const":"1.0"},"trigger":{"enum":["TASK","CHAT"]},"entry":{"type":"string","minLength":1},
  "inputs":{"type":"array","items":{"type":"object","required":["name","type"],"properties":{"name":{"type":"string"},"type":{"enum":["STRING","NUMBER","BOOLEAN","OBJECT","ARRAY","NULL"]},"required":{"type":"boolean"}}}},
  "outputs":{"type":"array","items":{"type":"object","required":["name","from"],"properties":{"name":{"type":"string"},"from":{"type":"string"}}}},
  "nodes":{"type":"array","minItems":1,"items":{"type":"object","required":["id","type"],"properties":{
   "id":{"type":"string","minLength":1,"maxLength":64},"type":{"enum":["START","END","LLM","SKILL","CONDITION","CODE","RETRIEVE","CONFIRM","AGENT","ONTOLOGY"]},"name":{"type":"string"},
   "skillRef":{"type":"object","required":["code","version"],"properties":{"code":{"type":"string"},"version":{"type":"integer","minimum":1},"skillVersionId":{"type":"integer","minimum":1}}},
   "args":{"type":"object"},"output":{"type":"object"},"expression":{"type":"string"},"confirmRoles":{"type":"array","items":{"type":"string"}},
   "branches":{"type":"array","items":{"type":"object","oneOf":[{"required":["when","to"]},{"required":["else"]}]}},
   "errorPolicy":{"type":"object","properties":{"onFail":{"enum":["TERMINATE","ERROR_EDGE","DEFAULT_VALUE"]},"retries":{"type":"integer","minimum":0},"timeoutMs":{"type":"integer","minimum":1},"errorEdgeTo":{"type":"string"},"defaultValue":{}}}
  }}},
  "edges":{"type":"array","items":{"type":"object","required":["from","to"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"when":{"type":"string"}}}},
  "joins":{"type":"array","items":{"type":"object","required":["nodeId","semantics"],"properties":{"nodeId":{"type":"string"},"semantics":{"enum":["ALL","ANY"]},"skipCountsAs":{"enum":["PASS","BLOCK"]},"allowSharedUpstream":{"type":"boolean"}}}},
  "executionRules":{"type":"object","required":["parallel","maxParallel","cyclesForbidden"],"properties":{"parallel":{"type":"boolean"},"maxParallel":{"type":"integer","minimum":1,"maximum":128},"cyclesForbidden":{"const":true}}}
 }
}
