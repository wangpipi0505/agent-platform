# All three base-image arguments MUST be explicit registry references with sha256 digests.
ARG JAVA_BUILD_IMAGE
ARG JAVA_RUNTIME_IMAGE
FROM ${JAVA_BUILD_IMAGE} AS health-build
WORKDIR /build
COPY deploy/HealthProbe.java .
RUN javac --release 21 HealthProbe.java

FROM ${JAVA_RUNTIME_IMAGE}
ARG SERVICE
WORKDIR /opt/agent
COPY --from=health-build /build/HealthProbe.class /opt/health/HealthProbe.class
COPY ${SERVICE}/target/${SERVICE}-0.1.0-SNAPSHOT.jar /opt/agent/service.jar
COPY .tools/deployment/opentelemetry-javaagent-2.20.1.jar /opt/agent/otel-agent.jar
RUN echo 'd94e9fc648cab37e540571352937acc06b8014182ddbd2d93a6c08641c84e48e  /opt/agent/otel-agent.jar' | sha256sum -c -
COPY deploy/entrypoint.sh /opt/agent/entrypoint.sh
USER 10001:10001
ENV SERVER_PORT=8080 AGENT_BIND_ADDRESS=0.0.0.0 AGENT_DEV_AUTH=false
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/bin/sh", "/opt/agent/entrypoint.sh"]
HEALTHCHECK --interval=15s --timeout=4s --start-period=90s --retries=3 CMD ["java", "-cp", "/opt/health", "HealthProbe", "http://127.0.0.1:8080/actuator/health/readiness"]
