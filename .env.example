# 仅为变量说明；scripts/start-database.ps1首次运行生成独立随机密钥，不要复制占位符运行。
AGENT_DB_URL=jdbc:postgresql://127.0.0.1:25432/agent_platform_dev_v12
AGENT_DB_USER=agent_v12
AGENT_DB_PASSWORD=<independent-random-password>
AGENT_JWT_SECRET=<independent-random-secret-at-least-32-characters>
AGENT_MASTER_KEY=<independent-64-hex-characters>
AGENT_SECRET_DIR=<new-project-root>/.local/secrets
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_DEV_AUTH=true
# 每实例本地执行槽；不是模型/技能的分布式并发许可或容量验收结果。
AGENT_INTERACTIVE_WORKERS=16
AGENT_BATCH_WORKERS=4
AGENT_SCHEDULER_POLL_MS=200
AGENT_SCHEDULER_LEASE_MS=90000
AGENT_SCHEDULER_DRAIN_MS=30000
# 以下外部服务必须使用新工程专用环境；未接通时如实返回不可用。
AGENT_MINIO_ENDPOINT=http://127.0.0.1:29000
AGENT_MINIO_ACCESS_KEY=<dedicated-service-account>
AGENT_MINIO_SECRET_KEY=<dedicated-service-secret>
AGENT_MINIO_BUCKET=agent-platform
# env:AGENT_SECRET_NAME仅在AGENT_SECRET_BINDINGS显式归属该tenant时可解析。
# AGENT_SECRET_BINDINGS={"AGENT_SECRET_NAME":"tenant-id"}
