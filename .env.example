# 仅为变量说明；scripts/start-database.ps1首次运行生成独立随机密钥，不要复制占位符运行。
AGENT_DB_URL=jdbc:postgresql://127.0.0.1:25432/agent_platform_dev_v12
AGENT_DB_USER=agent_v12
AGENT_DB_PASSWORD=<independent-random-password>
AGENT_JWT_SECRET=<independent-random-secret-at-least-32-characters>
AGENT_MASTER_KEY=<independent-64-hex-characters>
AGENT_SECRET_DIR=<new-project-root>/.local/secrets
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_DEV_AUTH=true
# 每实例本地执行槽；不是模型/技能的分布式并发许可或容量验收结果。
AGENT_INTERACTIVE_WORKERS=16
AGENT_BATCH_WORKERS=4
AGENT_SCHEDULER_POLL_MS=200
AGENT_SCHEDULER_LEASE_MS=90000
AGENT_SCHEDULER_DRAIN_MS=30000
# 以下外部服务必须使用新工程专用环境；未接通时如实返回不可用。
AGENT_MINIO_ENDPOINT=http://127.0.0.1:29000
AGENT_MINIO_ACCESS_KEY=<dedicated-service-account>
AGENT_MINIO_SECRET_KEY=<dedicated-service-secret>
AGENT_MINIO_BUCKET=agent-platform
# env:AGENT_SECRET_NAME仅在AGENT_SECRET_BINDINGS显式归属该tenant时可解析。
# AGENT_SECRET_BINDINGS={"AGENT_SECRET_NAME":"tenant-id"}

# 服务专用环境文件放本仓 .local/ 等忽略目录，使用绝对路径；不是在此处设置两服务共用的引用。
# scripts/start-backend.ps1 -ServiceEnvironmentFiles @{
#   'app-management'='<absolute-project-root>/.local/acceptance/app.env'
#   'engine-runtime'='<absolute-project-root>/.local/acceptance/engine.env'
# }
# app.env：仅给 app 的 binder。local-v12 必须替换为实际已验身份租户。
# AGENT_ONTOLOGY_API_KEY_REF=env:AGENT_SECRET_ONTO_APP_BINDER_KEY
# AGENT_SECRET_ONTO_APP_BINDER_KEY=<independent-binder-key>
# AGENT_SECRET_BINDINGS={"AGENT_SECRET_ONTO_APP_BINDER_KEY":"local-v12"}
# engine.env：仅给 engine 的 readonly。不得把 binder 密钥放在这里。
# AGENT_ONTOLOGY_API_KEY_REF=env:AGENT_SECRET_ONTO_ENGINE_READ_KEY
# AGENT_SECRET_ONTO_ENGINE_READ_KEY=<independent-readonly-key>
# AGENT_SECRET_BINDINGS={"AGENT_SECRET_ONTO_ENGINE_READ_KEY":"local-v12"}
# 已运行的进程不能重新加载环境；使用服务环境文件前先通过本仓停止脚本停服务。

# skill：DEGRADED 只降实例工作量校验；回调/治理/产物仍 STRICT。展开预算仅允许1..8192。
AGENT_SCHEMA_MODE=DEGRADED
AGENT_SCHEMA_MAX_EXPANDED_WORK=8192
# PROCESS 默认关闭；开启且可执行文件白名单为空时拒绝启动。路径必须为专用允许根/绝对可执行路径。
AGENT_PROCESS_ENABLED=false
AGENT_PROCESS_ALLOWED_EXECUTABLES=
# AUTHORITY 必须有已装配的 ServiceTicketProvider；缺失时拒绝运行，绝不回落 LEGACY。
AGENT_SKILL_SERVICE_TICKET_MODE=LEGACY
# engine：开启但三项上限均0仍为不限；要验配额必须配置非零上限。
AGENT_ENGINE_QUOTA_ENABLED=false
AGENT_ENGINE_QUOTA_WINDOW_SECONDS=3600
AGENT_ENGINE_QUOTA_TENANT_TOKENS=0
AGENT_ENGINE_QUOTA_APP_TOKENS=0
AGENT_ENGINE_QUOTA_CREDENTIAL_TOKENS=0
# gateway：入口滑动窗口；开启但max-requests<=0仍为不限。
AGENT_INTEGRATION_RATE_LIMIT_ENABLED=false
AGENT_INTEGRATION_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_INTEGRATION_RATE_LIMIT_MAX_REQUESTS=0
