+    static int stringUnits(JsonNode n) {
+        int units=0;
+        if(n.isObject()) {
+            var entries=n.fields();
+            while(entries.hasNext()) {
+                var e=entries.next();
+                units+=e.getKey().length()+stringUnits(e.getValue());
+            }
+        }
+        else if(n.isArray()) {
+            for(JsonNode x:n)units+=stringUnits(x);
+        }
+        else if(n.isTextual())units+=n.asText().length();
+        return units;
+    }
