                 lock.executeQuery().close();
                 assertEquals(0, new SkillOutbox(db, executor).drainTenant(tenant, 1));
             } finally {
                 connection.rollback();
             }
         }
         rejectFacts = false;
         assertEquals(1, new SkillOutbox(db, executor).drainTenant(tenant, 1));
         assertEquals("UNKNOWN", engineState.get());
         assertEquals(0, new SkillOutbox(db, executor).drainTenant(tenant, 1));
