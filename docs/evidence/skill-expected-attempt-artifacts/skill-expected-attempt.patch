                                 "attemptId",
                                 456,
                                 "skillVersionId",
                                 version,
                                 "arguments",
                                 arguments,
                                 "idempotencyKey",
                                 key,
                                 "leaseOwner",
                                 "worker"));
         authority =
                 new LinkedHashMap<String, Object>(
                         Map.of(
                                 "claimed",
                                 true,
                                 "status",
                                 "UNKNOWN",
                                 "skill_version_id",
                                 version,
                                 "skill_code",
                                 code,
                                 "args_digest",
                                 Digest.sha256(Json.canonical(request.get("arguments"))),
                                 "node_instance_id",
                                 123,
                                 "runId",
                                 "r_async",
                                 "trigger_type",
                                 "TASK",
                                 "idempotency_key",
