+    }
+
+    @Test
+    void queryOnlyNeverPostsAndWrongAttemptNeverQueriesOrWrites() {
+        db.update(
+                "update skill.external_job_binding set"
+                    + " send_started=true,status='SUBMITTED',external_job_id='job-1' where"
+                    + " tenant_id=? and call_id=?",
