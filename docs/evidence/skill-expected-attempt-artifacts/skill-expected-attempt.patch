         authority.put("attempt_id", 456);
         authority.put("skill_contract_sha256", catalog.versionId(version).get("sha256"));
         when(clients.get(anyString()))
                 .thenAnswer(
                         i ->
                                 Json.tree(
                                         i.<String>getArgument(0).contains("/admin/runs/")
                                                 ? Map.of(
