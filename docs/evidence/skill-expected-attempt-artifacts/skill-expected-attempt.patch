+        var racing =
+                new JdbcTemplate(Objects.requireNonNull(db.getDataSource())) {
+                    @Override
+                    public int update(String sql, Object... args) {
+                        if (sql.contains("status='SENDING'")) {
+                            String mutation =
+                                    switch (field) {
+                                        case "skill_version_id" -> "skill_version_id=102";
+                                        case "request_snapshot" ->
