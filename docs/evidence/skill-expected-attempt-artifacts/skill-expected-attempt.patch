-                                        "own-budget-run"));
+                                        "own-budget-run",
+                                        1));
         assertEquals(write ? "RESULT_UNKNOWN" : "OUTPUT_INVALID", failure.semantic);
         assertEquals(write, failure.unknown);
         assertEquals(
                 1, fixture.peer.calls.get(), "a validation failure must never resend the call");
