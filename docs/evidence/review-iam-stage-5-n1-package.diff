+-- One append-only metadata history; original SHA versions and all V216 rows remain intact.
+ALTER TABLE engine.material_scope ADD COLUMN material_revision bigint GENERATED BY DEFAULT AS IDENTITY;
+ALTER TABLE engine.material_scope DROP CONSTRAINT material_scope_kind_check;
+ALTER TABLE engine.material_scope DROP CONSTRAINT material_scope_material_version_check;
+ALTER TABLE engine.material_scope DROP CONSTRAINT material_scope_run_id_kind_key;
+ALTER TABLE engine.material_scope ALTER COLUMN material_version TYPE text;
+ALTER TABLE engine.material_scope ADD CONSTRAINT material_scope_kind_check CHECK(kind IN (
+ 'run-snapshot','run-inputs','run-version-refs',
+ 'run-state','run-budget','run-output','run-error',
+ 'node-definition','node-state','node-output','node-error',
+ 'attempt-state','attempt-request','attempt-checkpoint','attempt-error','run-event'));
+ALTER TABLE engine.material_scope ADD CONSTRAINT material_scope_material_version_check CHECK(
+ CASE WHEN kind IN ('run-snapshot','run-inputs','run-version-refs') THEN material_version ~ '^[a-f0-9]{64}$'
+ ELSE material_version ~ '^[1-9][0-9]*$' AND material_version=material_revision::text END);
+CREATE UNIQUE INDEX material_scope_initial_once ON engine.material_scope(run_id,kind)
+ WHERE kind IN ('run-snapshot','run-inputs','run-version-refs');
+CREATE UNIQUE INDEX material_scope_revision_unique ON engine.material_scope(material_revision);
+CREATE INDEX material_scope_current_locator ON engine.material_scope(run_id,kind,material_id,material_revision DESC);
