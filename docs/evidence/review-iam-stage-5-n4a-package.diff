+    @Test
+    void proofExpiringWhileRealExecutorQueuedNeverSendsPublishedGet() throws Exception {
+        try (var f = new Fixture()) {
+            var blocked = new CountDownLatch(1);
+            var submitted = new CountDownLatch(1);
+            var release = new CountDownLatch(1);
+            var controlFailure = new java.util.concurrent.atomic.AtomicReference<Throwable>();
+            var owned =
+                    new ThreadPoolExecutor(
+                            1, 1, 0, TimeUnit.MILLISECONDS, new ArrayBlockingQueue<>(1)) {
+                        @Override
+                        public void execute(Runnable task) {
+                            super.execute(task);
+                            if (!getQueue().isEmpty()) submitted.countDown();
+                        }
+                    };
+            owned.submit(
+                    () -> {
+                        blocked.countDown();
+                        try {
+                            if (!release.await(5, TimeUnit.SECONDS))
+                                throw new AssertionError("finite executor block timeout");
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        }
+                    });
+            assertThat(blocked.await(2, TimeUnit.SECONDS)).isTrue();
+            var control =
+                    Thread.ofPlatform()
+                            .name("n3-proof-expiry-control")
+                            .start(
+                                    () -> {
+                                        try {
+                                            if (!submitted.await(5, TimeUnit.SECONDS))
+                                                throw new AssertionError("finite submit timeout");
+                                            // The main passed caller checks and is queued. Only
+                                            // the verification clock changes; no real sleep or
+                                            // CPU exhaustion consumes the transport deadline.
+                                            f.iam.advanceClock(Duration.ofSeconds(6));
+                                        } catch (Throwable failure) {
+                                            controlFailure.set(failure);
+                                        } finally {
+                                            release.countDown();
+                                        }
+                                    });
+            try (var clients =
+                    new RuntimeClients(f.iam.config("engine"), f.engine, f.origin(), true, owned)) {
+                bound(
+                        f.iam,
+                        f.engine,
+                        proof -> {
+                            assertThatThrownBy(() -> clients.published(CODE, proof))
+                                    .isInstanceOfSatisfying(
+                                            PlatformException.class,
+                                            e -> assertThat(e.status()).isEqualTo(403));
+                            return null;
+                        });
+                assertThat(f.sends).hasValue(0);
+            } finally {
+                release.countDown();
+                control.join(2000);
+                owned.shutdownNow();
+                assertThat(owned.awaitTermination(2, TimeUnit.SECONDS)).isTrue();
+                assertThat(control.isAlive()).isFalse();
+                assertThat(controlFailure.get()).isNull();
+            }
+        }
+    }
