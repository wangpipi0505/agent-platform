     static void concurrentWrite(long id,RetainedAuthorization proof){
         var tx=new TransactionTemplate(new DataSourceTransactionManager(ds));tx.setIsolationLevel(4);
         tx.execute(s->{
             db.queryForObject("select id from engine.run where id=? for update",Long.class,id);
             var binding=RunAuthorityStore.load(db,id,true);var materials=new MaterialScopeStore(ds,iam.clock());materials.requireWriter(binding,proof,false);var parents=materials.currentScopes(binding);
             db.update("update engine.run set output='{\"generation\":\"after\"}'::jsonb,event_seq=event_seq+1 where id=?",id);
             int seq=db.queryForObject("select event_seq from engine.run where id=?",Integer.class,id);
             long event=db.queryForObject("insert into engine.run_event(run_id,seq,type,payload) values(?,?,'AFTER_SNAPSHOT','{\"generation\":\"after\"}'::jsonb) returning id",Long.class,id,seq);
             materials.append(binding,"run-output",binding.publicId(),proof,parents);materials.append(binding,"run-state",binding.publicId(),proof,parents);materials.append(binding,"run-event",Long.toString(event),proof,parents);proof.requireVerified();return null;
         });proof.requireVerified();
     }
