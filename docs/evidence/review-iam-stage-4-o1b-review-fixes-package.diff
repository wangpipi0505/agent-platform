     static <T>T withStatusFrame(ServiceTicket ticket,String run,Function<RetainedAuthorization,T> work)throws Exception {
         try(var decoder=new TrustedJwtDecoder(iam.config("engine"),iam.clock(),true)){
             var request=new MockHttpServletRequest("GET","/admin/runs/"+run);var response=new MockHttpServletResponse();request.setAttribute(HandlerMapping.BEST_MATCHING_PATTERN_ATTRIBUTE,"/admin/runs/{id}");
             var handler=new HandlerMethod(new RunController(service,trace,null,null),RunController.class.getMethod("status",String.class,jakarta.servlet.http.HttpServletRequest.class,jakarta.servlet.http.HttpServletResponse.class));
             request.setAttribute(HandlerMapping.BEST_MATCHING_HANDLER_ATTRIBUTE,handler);RequestContextHolder.setRequestAttributes(new ServletRequestAttributes(request));SecurityContextHolder.getContext().setAuthentication(new JwtAuthenticationToken(decoder.decode(ticket.value()),List.of()));
             var guard=new ServiceAuthorization("engine",new ServiceRoutePolicy(),engine);
             try{guard.preHandle(request,response,handler);return work.apply(AuthorityContext.requireInitialFor(Actor.current(),AuthorityContext.current().call().resource()));}
             finally{guard.afterCompletion(request,response,handler,null);SecurityContextHolder.clearContext();RequestContextHolder.resetRequestAttributes();}
         }
     }
     static String raw(String target,String ticket,String body)throws Exception {
