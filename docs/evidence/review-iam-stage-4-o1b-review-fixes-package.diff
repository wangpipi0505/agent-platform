             socket.setSoTimeout(10000);var out=socket.getOutputStream();byte[] bytes=body.getBytes(StandardCharsets.UTF_8);
             out.write(("GET "+target+" HTTP/1.1\r\nHost: 127.0.0.1\r\nAuthorization: Bearer "+ticket+"\r\nContent-Type: application/json\r\nContent-Length: "+bytes.length+"\r\nConnection: close\r\n\r\n").getBytes(StandardCharsets.US_ASCII));out.write(bytes);out.flush();return new String(socket.getInputStream().readAllBytes(),StandardCharsets.UTF_8);
         }
     }
