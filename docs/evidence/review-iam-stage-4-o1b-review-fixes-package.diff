     static void assertReadOnlySql(){
         var allowed=new HashSet<>(List.of(
             "select r.id,r.public_id,r.tenant_id,r.principal_id,r.trigger_type,r.mode,(r.debug_snapshot is not null or r.eval_candidate is not null or r.controlled_draft_skill_version_id is not null or r.controlled_draft_skill_digest is not null or r.controlled_skill_test_version_id is not null or r.controlled_skill_test_digest is not null or r.controlled_skill_test_status is not null) as unsupported,exists(select 1 from engine.tool_call t where t.run_id=r.id) as has_tools from engine.run r where r.public_id=? and r.tenant_id=? and r.principal_id=?",
             "select r.id,r.public_id,r.tenant_id as run_tenant,r.principal_id as run_principal,r.app_code,r.app_version_id as run_version,a.* from engine.run r join engine.run_authority a on a.run_id=r.id where r.id=?",
             "select tenant_id,producer,kind,material_id,material_version,payload_sha256,scope_sha256,scope::text as scope from engine.material_scope where run_id=? and kind in ('run-snapshot','run-inputs','run-version-refs')",
             "select distinct on (kind,material_id) tenant_id,producer,kind,material_id,material_version,payload_sha256,scope_sha256,scope::text as scope,material_revision from engine.material_scope where run_id=? and kind not in ('run-snapshot','run-inputs','run-version-refs') order by kind,material_id,material_revision desc",
             "select run_id from engine.node_instance where id=?","select run_id from engine.run_event where id=?","select public_id from engine.run where id=?",
             "select scope::text from engine.material_scope where run_id=? and scope_sha256=? and material_revision<?",
             "select id from engine.node_instance where run_id=? order by step_seq","select id from engine.run_event where run_id=? order by seq"));
         for(String field:List.of("snapshot","inputs","version_refs","budget","output","error"))allowed.add("select "+field+"::text from engine.run where id=?");
         for(String field:List.of("definition","output","error"))allowed.add("select "+field+"::text from engine.node_instance where id=?");
         allowed.add(statusProjection("run","id,public_id,app_code,status,event_seq,stop_reason,started_at,ended_at,mode,trigger_type,output_ref"));
         allowed.add(statusProjection("node_instance","id,run_id,node_def_id,step_seq,node_type,join_semantics,status,committed_attempt_id,committed_output_ref,input_digest,output_digest,started_at,ended_at,pause_seq,released,winner_node_id"));
         allowed.add(statusProjection("run_event","id,run_id,seq,type,payload,created_at"));
         assertThat(statements).isNotEmpty().allSatisfy(s->{assertThat(allowed).as("exact SQL allowlist").contains(s.sql());assertThat(s.isolation()).isEqualTo(4);assertThat(s.readOnly()).isTrue();assertThat(s.autoCommit()).isFalse();});
     }
     static String statusProjection(String table,String columns){
         var fields=Arrays.stream(columns.split(",")).map(c->Set.of("started_at","ended_at","created_at").contains(c)?"to_char("+c+" at time zone 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') as "+c:c).toList();
         return "select row_to_json(material)::text from (select "+String.join(",",fields)+" from engine."+table+" where id=?) material";
     }
     @Test void actualSignedWrongCallerTargetSourceOriginWorkloadAndShaFailBeforePayload()throws Exception {
         long id=completeRun();String run=publicId(id);var ticket=metadataThenStatus(run);
         for(String field:List.of("caller","target","action","authority_mode","source_kind","origin_kind","snapshotSha")){
             var claims=Json.mapper().convertValue(Json.read(new String(Base64.getUrlDecoder().decode(ticket.value().split("\\.")[1]),StandardCharsets.UTF_8)),Map.class);
             if(Set.of("source_kind","origin_kind").contains(field))((Map<String,Object>)claims.get("operation")).put(field,"INTEGRATION");
             else if(field.equals("snapshotSha"))((Map<String,Object>)claims.get("resource")).put("version_digest",Digest.sha256("other"));
             else claims.put(field,switch(field){case "caller","target"->"app";case "action"->"run.advance";default->"workload";});
             var signed=iam.sign(claims,iam.authoritySigningKey(),"at+jwt");statements.clear();int count=iam.authorityCalls();
             var response=http.send(HttpRequest.newBuilder(URI.create("http://127.0.0.1:"+context.getWebServer().getPort()+"/admin/runs/"+run)).timeout(Duration.ofSeconds(15)).header("Authorization","Bearer "+signed).GET().build(),HttpResponse.BodyHandlers.ofString());
             assertThat(response.statusCode()).isIn(401,403);assertThat(response.body()).doesNotContain("\"runId\"","\"nodes\"","\"events\"");assertThat(statements).isEmpty();assertThat(iam.authorityCalls()-count).isLessThanOrEqualTo(1);
             System.out.println("O1B_SIGNED_PURPOSE="+Json.write(Map.of("field",field,"authorityDelta",iam.authorityCalls()-count,"status",response.statusCode())));
         }
     }
     @Test void movedPublishedFlowPureGateKeepsOriginalFiniteDependencies(){
         var valid=Json.read("{\"type\":\"FLOW\",\"config\":{},\"definition\":{\"nodes\":[{\"id\":\"s\",\"type\":\"START\"},{\"id\":\"e\",\"type\":\"END\"}],\"edges\":[]}}");
         GraphRules.requirePublishedFlow(valid);
         for(String type:List.of("AGENT","LLM","SKILL","RETRIEVE","CONFIRM","UNKNOWN")){
             var candidate=(com.fasterxml.jackson.databind.node.ObjectNode)valid.deepCopy();((com.fasterxml.jackson.databind.node.ObjectNode)candidate.path("definition").path("nodes").get(1)).put("type",type);
             assertThatThrownBy(()->GraphRules.requirePublishedFlow(candidate)).isInstanceOf(PlatformException.class);
         }
         for(String key:List.of("skillRefs","promptRefs","modelEntryId","modelBinding","tools","frozenPrompts","dataSources")){
             var candidate=(com.fasterxml.jackson.databind.node.ObjectNode)valid.deepCopy();((com.fasterxml.jackson.databind.node.ObjectNode)candidate.path("config")).set(key,Json.tree(List.of("external")));
             assertThatThrownBy(()->GraphRules.requirePublishedFlow(candidate)).isInstanceOf(PlatformException.class);
         }
     }
     @Test void partialBusinessWriteClosesActualStreamAndNeverRetriesStatus()throws Exception {
         long id=completeRun();String run=publicId(id);var m=metadataThenStatus(run);
         var logger=(ch.qos.logback.classic.Logger)org.slf4j.LoggerFactory.getLogger(RunController.class);var previous=logger.getLevel();
         var appender=new ch.qos.logback.core.read.ListAppender<ch.qos.logback.classic.spi.ILoggingEvent>();appender.start();logger.addAppender(appender);logger.setLevel(ch.qos.logback.classic.Level.WARN);
         try{
             int count=iam.authorityCalls();statements.clear();failBusinessWrite=true;partialClosed.set(false);
             String response=raw("/admin/runs/"+run,m.value(),"");failBusinessWrite=false;
             assertThat(response).startsWith("HTTP/1.1 200");assertThat(response).contains("\"runId\"");assertThat(response).doesNotContain("RUN_STATUS_TOO_LARGE","O1B_FINITE_PARTIAL_WRITE","\"events\"");
             String body=response.substring(response.indexOf("\r\n\r\n")+4);int boundary=body.indexOf("\r\n");int observed=Integer.parseInt(body.substring(0,boundary),16);String peerBody=body.substring(boundary+2,boundary+2+observed);
             assertThat(peerBody.getBytes(StandardCharsets.UTF_8).length).isEqualTo(128);assertThatThrownBy(()->Json.mapper().readTree(peerBody)).isInstanceOf(com.fasterxml.jackson.core.JsonProcessingException.class);
             assertThat(payloadReads()).isEqualTo(16);assertThat(iam.authorityCalls()-count).isEqualTo(2);
             assertThat(appender.list).singleElement().satisfies(event->{assertThat(event.getFormattedMessage()).contains("committed=true","attemptedBytes=","actualBytes=unknown");assertThat(event.getThrowableProxy().getCause().getMessage()).contains("O1B_FINITE_PARTIAL_WRITE");assertThat(event.getThrowableProxy().getSuppressed()).hasSize(1);});
             // Spring 6.2.7 retires its lifecycle stream on the failed write. The best-effort close
             // is itself rejected before reaching our delegate; container EOF still ends peer I/O.
             assertThat(partialClosed).isFalse();
             System.out.println("O1B_PARTIAL_IO="+Json.write(Map.of("actualRawUtf8Bytes",response.getBytes(StandardCharsets.UTF_8).length,"peerBusinessBytes",peerBody.getBytes(StandardCharsets.UTF_8).length,"injectedBusinessWriteBytes",128,"delegateClosed",partialClosed.get(),"closeAttemptRejectedByMvc",true,"authorityDelta",iam.authorityCalls()-count,"wire",response)));
         }finally{failBusinessWrite=false;logger.detachAppender(appender);logger.setLevel(previous);appender.stop();}
     }
 
