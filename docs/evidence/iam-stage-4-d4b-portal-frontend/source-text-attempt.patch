+    try {
+      if(options.mode==='portal'&&!provider){auth.connection='missing';auth.notice='请从门户打开工作台';return;}
+      let token:string;
+      if(options.mode==='dev') {
+        // An explicit build/start choice, never a fallback from portal failure.
