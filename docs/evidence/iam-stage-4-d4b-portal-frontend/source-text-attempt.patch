+    }
+  }
+  if(options.mode==='portal'&&provider) {
+    try {
+      unsubscribe=provider.onSessionChanged(()=>{void connect();});
+      if(typeof unsubscribe!=='function')throw Error('门户会话订阅无效');
+    } catch(e:any) {provider=undefined;auth.connection='error';auth.notice=e.message;}
+  }
