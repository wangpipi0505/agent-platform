                     (sent, response) -> {
                         int code = response.getStatusCode().value();
                         if (code >= 400)
                             throw new Failure(
                                     code == 403
                                             ? "NO_PERMISSION"
                                             : code == 429
                                                     ? "QUOTA"
                                                     : code < 500
                                                             ? "PARAM_ERROR"
                                                             : sideEffect
                                                                     ? "RESULT_UNKNOWN"
                                                                     : "RETRYABLE_FAILURE",
                                     sideEffect && code >= 500,
                                     "外部端点HTTP " + code);
