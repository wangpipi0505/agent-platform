                     });
         } catch (Failure ex) {
             throw ex;
         } catch (Exception ex) {
             throw new Failure(
                     sideEffect ? "RESULT_UNKNOWN" : "RETRYABLE_FAILURE",
                     sideEffect,
                     "外部端点连接、超时或结果接收失败");
         } finally {
             if (patchClient != null) patchClient.close();
         }
     }
 
