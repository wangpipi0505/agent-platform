     public Download download(String id, String runId) {
         var row = owned(id, runId);
         try {
             return new Download(
                     client().getObject(
                                     GetObjectArgs.builder()
                                             .bucket(row.get("bucket").toString())
                                             .object(row.get("object_key").toString())
