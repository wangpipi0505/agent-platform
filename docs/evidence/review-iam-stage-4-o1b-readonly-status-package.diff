                                 output,
                                 null,
                                 "stream_status",
                                 Json.write(
                                         Map.of(
                                                 "chunkAvailable",
                                                 chunks.chunkAvailable(),
                                                 "chunkReplay",
                                                 false,
                                                 "recovery",
                                                 "LAST_EVENT_ID_AND_FINAL_SNAPSHOT")));
