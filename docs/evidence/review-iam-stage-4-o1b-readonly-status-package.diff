                                 && System.nanoTime() < until) {
                             if (subscription.stopped()) {
                                 send(
                                         output,
                                         null,
                                         "stream_reset",
                                         Json.write(
                                                 Map.of(
                                                         "reason",
                                                         subscription.resetReason(),
                                                         "chunkReplay",
                                                         false,
                                                         "lastEventId",
                                                         last,
                                                         "recovery",
                                                         "LAST_EVENT_ID_AND_FINAL_SNAPSHOT")));
