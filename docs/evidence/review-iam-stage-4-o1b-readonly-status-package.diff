                 "insert into"
                     + " engine.material_scope(run_id,tenant_id,producer,kind,material_id,material_version,payload_sha256,scope_sha256,scope)"
                     + " values(?,?,?,?,?,?,?,?,?::jsonb)",
                 b.runId(),
                 scope.owner().tenantId(),
                 r.producer(),
                 r.kind(),
                 r.id(),
                 r.version(),
                 r.payloadSha256(),
                 scope.scopeSha256(),
