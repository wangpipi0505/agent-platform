+                                + " principal_id=? and state='READY' and expires_at>now()",
+                        id,
+                        actor.tenantId(),
+                        actor.principalId());
+        if (rows.isEmpty() || runId != null && !runId.equals(rows.getFirst().get("run_id")))
+            throw denied();
+        return rows.getFirst();
+    }
