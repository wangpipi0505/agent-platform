+    @Test void declaredExcessiveLengthAbortsBeforeClosingStalledBody()throws Exception {
+        for(boolean metadata:List.of(true,false)){
+            int limit=metadata?8192:2*1024*1024;
+            earlyRejection("declared-length",metadata,response(200,"Content-Length: "+(limit+1)+"\r\n",new byte[0]));
+        }
+    }
+    @Test void preBodyRejectionsAbortBeforeClosingStalledBody()throws Exception {
+        for(boolean metadata:List.of(true,false)){
+            for(int status:List.of(599,401))earlyRejection("status-"+status,metadata,response(status,"Content-Length: 32\r\n",new byte[0]));
+            earlyRejection("unsafe-header",metadata,response(200,"Set-Cookie: private=yes\r\nContent-Length: 32\r\n",new byte[0]));
+            earlyRejection("wrong-type",metadata,utf("HTTP/1.1 200 Finite\r\nContent-Type: text/plain\r\nContent-Length: 32\r\n\r\n"));
+        }
+    }
+    static void earlyRejection(String reason,boolean metadata,byte[] response)throws Exception {
+        // An unfinished declared body forces graceful close to wait unless the installed handle aborts first.
+        try(var p=new Peer(response,true);var h=new PublishedRunHttp()){
+            var cancel=new PublishedRunHttp.Cancellation();long begin=System.nanoTime();
+            unavailable(()->{if(metadata)h.getRunObservationMetadata(p.origin(),RUN,"t",deadline(),cancel,()->{});else h.getRunStatus(p.origin(),RUN,"t",deadline(),cancel,()->{});});
+            long elapsed=System.nanoTime()-begin;
+            System.out.println("O1C_EARLY_REJECTION="+Json.write(Map.of("reason",reason,"policy",metadata?"Q":"M","elapsedMs",TimeUnit.NANOSECONDS.toMillis(elapsed),"requests",p.accepts.get(),"installedHandles",cancel.installedHandles(),"cancelledHandles",cancel.cancelledHandles(),"cancelled",cancel.cancelled())));
+            assertThat(Duration.ofNanos(elapsed)).isLessThan(Duration.ofSeconds(1));
+            assertThat(p.request()).startsWith("GET "+(metadata?"/internal/runs/"+RUN+"/observation-metadata":"/admin/runs/"+RUN)+" HTTP/1.1");
+            assertThat(p.accepts.get()).isEqualTo(1);assertThat(cancel.installedHandles()).isEqualTo(1);assertThat(cancel.cancelled()).isTrue();assertThat(cancel.cancelledHandles()).isEqualTo(1);
+        }
+    }
