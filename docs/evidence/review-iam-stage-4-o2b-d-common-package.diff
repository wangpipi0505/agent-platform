         } catch (InterruptedException interrupted) {
             Thread.currentThread().interrupt();
             task.cancel(true);
             throw BoundedIamHttp.unavailable();
         } catch (TimeoutException timeout) {
             task.cancel(true);
             throw AuthorityProtocol.expired();
         } catch (CancellationException cancelled) {
             throw BoundedIamHttp.unavailable();
