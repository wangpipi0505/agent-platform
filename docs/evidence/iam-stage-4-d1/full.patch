+    static final class MutableClock extends Clock {
+        Instant now=NOW;
+        public ZoneId getZone(){return ZoneOffset.UTC;}
+        public Clock withZone(ZoneId zone){return this;}
+        public Instant instant(){return now;}
+    }
+    // A composed decoder must keep IAM semantics through the explicit deployment argument.
+    record WrappedDecoder(TrustedJwtDecoder delegate) implements JwtDecoder,AutoCloseable {
+        public org.springframework.security.oauth2.jwt.Jwt decode(String token){return delegate.decode(token);}
+        public void close(){delegate.close();}
+    }
+    static LoopbackIssuer webIssuer;
+    static boolean internalWeb;
+    static final AtomicInteger handlers=new AtomicInteger();
+    @Configuration(proxyBeanMethods=false) @EnableAutoConfiguration @EnableWebSecurity
+    static class ProbeApp {
+        @Bean JwtDecoder decoder(){return new WrappedDecoder(new TrustedJwtDecoder(internalWeb ? webIssuer.internalConfig() : webIssuer.config(),Clock.fixed(NOW,ZoneOffset.UTC),true));}
+        @Bean SecurityFilterChain filter(HttpSecurity http,JwtDecoder decoder,ObjectProvider<ApiKeyAuthenticator> keys)throws Exception{
+            // Invoke the real chain method without importing production configuration's closed IAM startup guard.
+            var method=SecurityConfiguration.class.getDeclaredMethod("security",HttpSecurity.class,JwtDecoder.class,CorsConfigurationSource.class,ObjectProvider.class,AuthorityProperties.class);
+            method.setAccessible(true);
+            return (SecurityFilterChain)method.invoke(new SecurityConfiguration(),http,decoder,(CorsConfigurationSource)request->null,keys,internalWeb ? webIssuer.internalConfig() : webIssuer.config());
+        }
+        @Bean ProbeController probe(){return new ProbeController();}
+    }
+    @RestController static class ProbeController {
+        @GetMapping({"/v1/probe","/internal/probe"}) Object get(){handlers.incrementAndGet();return Actor.current();}
+    }
