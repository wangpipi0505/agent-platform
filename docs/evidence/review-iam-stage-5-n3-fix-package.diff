         // Published rows are immutable. Every negative variant seeds another real published app;
         // no fixture UPDATE bypasses the app_version protection trigger.
         tenant = "n3-" + UUID.randomUUID();
         iam.clearFiniteGrants();
         iam.portalActor(actor(Set.of("A", "B")));
         gateway.close();
         gateway = iam.client("gateway");
         source = iam.portal();
         versionId =
                 command(
                                 Map.of(
                                         "action",
                                         "seed",
                                         "tenant",
                                         tenant,
                                         "snapshot",
                                         snapshot,
                                         "sha",
                                         SHA,
                                         "sha2",
                                         SHA2))
                         .path("versionId")
                         .asLong();
     }
 
