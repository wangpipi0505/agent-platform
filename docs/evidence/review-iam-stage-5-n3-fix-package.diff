     static JsonNode success(HttpResponse<String> response) {
         assertThat(response.statusCode()).as(response.body()).isEqualTo(200);
         return Json.read(response.body()).path("data");
     }
 
     static void denied(HttpResponse<String> response, int... codes) {
         assertThat(response.statusCode())
                 .as(response.body())
                 .isIn(Arrays.stream(codes).boxed().toList());
         assertThat(
                         Json.read(response.body()).path("data").isNull()
                                 || Json.read(response.body()).path("data").isMissingNode())
                 .isTrue();
     }
 
     static void terminal() throws Exception {
         long until = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);
         while (scheduler.activeWorkers() > 0 && System.nanoTime() < until) Thread.sleep(10);
         assertThat(scheduler.activeWorkers()).isZero();
     }
 
     static HttpResponse<String> post(JsonNode request) throws Exception {
         return post(
                 request, gateway.exchange(source, MAIN).value(), "/admin/apps/" + CODE + "/runs");
     }
 
     static HttpResponse<String> post(JsonNode request, String ticket, String path)
             throws Exception {
         try (var http = HttpClient.newHttpClient()) {
             return http.send(
                     HttpRequest.newBuilder(
                                     URI.create(
                                             "http://127.0.0.1:"
                                                     + context.getWebServer().getPort()
                                                     + path))
                             .timeout(Duration.ofSeconds(15))
                             .header("Content-Type", "application/json")
                             .header("Authorization", "Bearer " + ticket)
                             .POST(HttpRequest.BodyPublishers.ofString(request.toString()))
                             .build(),
                     HttpResponse.BodyHandlers.ofString());
         }
     }
 
     @Test
     void actualPublishedAdmissionAndOwnedWorkerReturnFullStatus() throws Exception {
         var result = post(input("normal"));
         assertThat(result.statusCode()).as(result.body()).isEqualTo(200);
         var data = Json.read(result.body()).path("data");
         assertThat(data.path("runId").asText()).startsWith("r_");
         for (String field :
                 List.of(
                         "appCode",
                         "status",
                         "eventsWatermark",
                         "inputs",
                         "output",
                         "fileRefs",
                         "error",
                         "versionRefs",
                         "nodes",
                         "events",
                         "paused")) assertThat(data.has(field)).as(field).isTrue();
         assertThat(data.path("nodes")).hasSize(2);
         long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);
         while (!"SUCCEEDED"
                         .equals(
                                 db.queryForObject(
                                         "select status from engine.run where tenant_id=?",
                                         String.class,
                                         tenant))
                 && System.nanoTime() < deadline) Thread.sleep(10);
         var replay = post(input("normal"));
         assertThat(replay.statusCode()).as(replay.body()).isEqualTo(200);
         var complete = Json.read(replay.body()).path("data");
         assertThat(complete.path("runId")).isEqualTo(data.path("runId"));
         assertThat(complete.path("status").asText()).isEqualTo("SUCCEEDED");
         assertThat(complete.path("output").path("a").asInt()).isEqualTo(7);
         assertThat(count("run")).isEqualTo(1);
         assertThat(count("attempt")).isEqualTo(2);
         assertThat(count("material_scope")).isGreaterThan(15);
         assertThat(
                         db.queryForObject(
                                 "select app_version_id from engine.run where tenant_id=?",
                                 Long.class,
                                 tenant))
                 .isEqualTo(versionId);
         assertThat(
                         db.queryForObject(
                                 "select input_ref='pg:run/'||public_id||'/input' from engine.run"
                                     + " where tenant_id=?",
                                 Boolean.class,
                                 tenant))
                 .isTrue();
         assertThat(complete.path("events")).isNotEmpty();
         assertThat(complete.path("events").findValuesAsText("type"))
                 .contains("RUN_STARTED", "NODE_STARTED", "RUN_FINISHED");
         assertThat(legacyCalls).hasValue(0);
     }
 
     @Test
     void explicitVersionDebugStepAndV1AliasAreClosedBeforeAppSend() throws Exception {
         int sends = appRequests();
         for (String key :
                 List.of(
                         "versionNo",
                         "candidateSha256",
                         "draftRev",
                         "breakpoints",
                         "mocks",
                         "sessionId",
                         "historyRefs",
                         "materialRefs",
                         "controlledReplay")) {
             var request = (com.fasterxml.jackson.databind.node.ObjectNode) input(key);
             request.set(key, key.equals("versionNo") ? Json.tree(1) : Json.object());
             denied(post(request), 403);
         }
         var step = (com.fasterxml.jackson.databind.node.ObjectNode) input("step");
         step.put("mode", "STEP");
         denied(post(step), 403);
         denied(
                 post(
                         input("alias"),
                         gateway.exchange(source, MAIN).value(),
                         "/v1/apps/" + CODE + "/runs"),
                 403);
         assertThat(appRequests()).isEqualTo(sends);
         noAdmission();
     }
 
     @Test
     void unsupportedGraphAndEveryDependencyAreRejectedBeforeLegacyPreparation() throws Exception {
         for (String type : List.of("AGENT", "LLM", "SKILL", "RETRIEVE", "CONFIRM", "UNKNOWN")) {
             var value = (com.fasterxml.jackson.databind.node.ObjectNode) snapshot();
             ((com.fasterxml.jackson.databind.node.ObjectNode)
                             value.path("definition").path("nodes").get(1))
                     .put("type", type);
             setSnapshot(value);
             denied(post(input("node-" + type)), 403);
