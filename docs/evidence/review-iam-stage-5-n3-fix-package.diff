     static String awaitLine(String prefix, int seconds) throws Exception {
         long until = System.nanoTime() + TimeUnit.SECONDS.toNanos(seconds);
         while (System.nanoTime() < until) {
             String line = lines.poll(100, TimeUnit.MILLISECONDS);
             if (line != null && line.startsWith(prefix)) return line.substring(prefix.length());
             if (!child.isAlive()) break;
         }
         synchronized (childOutput) {
             throw new AssertionError("Finite child deadline: " + prefix + "\n" + childOutput);
         }
     }
 
     static JsonNode command(Object c) throws Exception {
         control.write(Json.write(c));
         control.newLine();
         control.flush();
         return Json.read(awaitLine("N3_APP_REPLY=", 5));
     }
 
     static long count(String table) {
         String sql =
                 switch (table) {
                     case "run" -> "select count(*) from engine.run where tenant_id=?";
                     case "material_scope" ->
                             "select count(*) from engine.material_scope where tenant_id=?";
                     case "node_instance" ->
                             "select count(*) from engine.node_instance n join engine.run r on"
                                 + " r.id=n.run_id where r.tenant_id=?";
                     case "attempt" ->
                             "select count(*) from engine.attempt a join engine.node_instance n on"
                                 + " n.id=a.node_instance_id join engine.run r on r.id=n.run_id"
                                 + " where r.tenant_id=?";
                     default -> throw new IllegalArgumentException();
                 };
         return db.queryForObject(sql, Long.class, tenant);
     }
 
