     @Test
     void capacityFullRecheckWaitsForCommittedSameRequestAndReadsOnlyAfterLock() throws Exception {
         var firstInsert = new CountDownLatch(1);
         var allowInsert = new CountDownLatch(1);
         var firstCommitted = new CountDownLatch(1);
         var allowCreated = new CountDownLatch(1);
         var secondSnapshot = new CountDownLatch(1);
         var allowSecond = new CountDownLatch(1);
         var firstTime = new AtomicBoolean();
         observed.beforeSql =
                 sql -> {
                     if (sql.startsWith("insert into engine.run(")
                             && firstTime.compareAndSet(false, true)) {
                         firstInsert.countDown();
                         latch(allowInsert);
                     }
                 };
         beforeCreated =
                 () -> {
                     firstCommitted.countDown();
                     latch(allowCreated);
                 };
         try (var occupied = scheduler.reserveInteractive();
                 var tasks = Executors.newFixedThreadPool(2)) {
             String one = gateway.exchange(source, MAIN).value(),
                     two = gateway.exchange(source, MAIN).value();
             var first =
                     tasks.submit(
                             () -> post(input("capacity"), one, "/admin/apps/" + CODE + "/runs"));
             latch(firstInsert);
             afterQuery =
                     sql -> {
                         if (sql.contains("request_id=?")
                                 && !org.springframework.transaction.support
                                         .TransactionSynchronizationManager
                                         .isActualTransactionActive()) {
                             secondSnapshot.countDown();
                             latch(allowSecond);
                         }
                     };
             var second =
                     tasks.submit(
                             () -> post(input("capacity"), two, "/admin/apps/" + CODE + "/runs"));
             latch(secondSnapshot);
             allowInsert.countDown();
             latch(firstCommitted);
             allowSecond.countDown();
             var b = success(second.get(10, TimeUnit.SECONDS));
             allowCreated.countDown();
             var a = success(first.get(10, TimeUnit.SECONDS));
             assertThat(a.path("runId")).isEqualTo(b.path("runId"));
             assertThat(count("run")).isEqualTo(1);
             assertThat(createdCalls).hasValue(1);
             assertThat(
                             statements.stream()
                                     .filter(s -> s.sql.contains("request_id=?") && s.transaction)
                                     .count())
                     .isEqualTo(2);
         } finally {
             allowInsert.countDown();
             allowCreated.countDown();
             allowSecond.countDown();
             observed.beforeSql = sql -> {};
             beforeCreated = () -> {};
             afterQuery = sql -> {};
         }
         terminal();
     }
 
     @Test
     void actualAdvisoryWaitCannotOutliveBoundProofAndLockTimeoutIsFinite() throws Exception {
         try (var lock = ds.getConnection()) {
             lock.setAutoCommit(false);
             try (var sql =
                     lock.prepareStatement("select pg_advisory_xact_lock(hashtextextended(?,0))")) {
                 sql.setString(1, tenant + ":alice:locked");
                 sql.execute();
             }
             var waiting = new CountDownLatch(1);
             observed.beforeSql =
                     sql -> {
                         if (sql.contains("pg_advisory_xact_lock")) waiting.countDown();
                     };
             try (var task = Executors.newSingleThreadExecutor()) {
                 String ticket = gateway.exchange(source, MAIN).value();
                 var request =
                         task.submit(
                                 () ->
                                         post(
                                                 input("locked"),
                                                 ticket,
                                                 "/admin/apps/" + CODE + "/runs"));
                 latch(waiting);
                 long until = System.nanoTime() + TimeUnit.SECONDS.toNanos(1);
                 while (db.queryForObject(
                                         "select count(*) from pg_locks where locktype='advisory'"
                                             + " and database=(select oid from pg_database where"
                                             + " datname=current_database()) and not granted",
                                         Long.class)
                                 == 0
                         && System.nanoTime() < until) Thread.sleep(5);
                 iam.advanceClock(Duration.ofSeconds(6));
                 lock.commit();
                 denied(request.get(5, TimeUnit.SECONDS), 403);
                 noAdmission();
             } finally {
                 observed.beforeSql = sql -> {};
                 lock.rollback();
             }
         }
         command(Map.of("action", "clock", "now", iam.clock().instant().toString()));
         try (var lock = ds.getConnection()) {
             lock.setAutoCommit(false);
             try (var sql =
                     lock.prepareStatement("select pg_advisory_xact_lock(hashtextextended(?,0))")) {
                 sql.setString(1, tenant + ":alice:timeout");
                 sql.execute();
             }
             long start = System.nanoTime();
             denied(post(input("timeout")), 403);
             assertThat(sqlState).hasValue("55P03");
             assertThat(Duration.ofNanos(System.nanoTime() - start))
                     .isLessThan(Duration.ofSeconds(4));
             lock.rollback();
             noAdmission();
         }
     }
 }
