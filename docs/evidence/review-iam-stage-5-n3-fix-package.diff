     static java.sql.Connection observe(java.sql.Connection connection) {
         return (java.sql.Connection)
                 java.lang.reflect.Proxy.newProxyInstance(
                         PublishedAdmissionHttpPostgresTest.class.getClassLoader(),
                         new Class[] {java.sql.Connection.class},
                         (proxy, method, args) -> {
                             try {
                                 Object value = method.invoke(connection, args);
                                 if (method.getName().equals("prepareStatement")
                                         && args[0] instanceof String sql) {
                                     var statement = (java.sql.PreparedStatement) value;
                                     return java.lang.reflect.Proxy.newProxyInstance(
                                             PublishedAdmissionHttpPostgresTest.class
                                                     .getClassLoader(),
                                             new Class[] {java.sql.PreparedStatement.class},
                                             (p, m, a) -> {
                                                 try {
                                                     if (m.getName().startsWith("execute"))
                                                         statements.add(
                                                                 new Sql(
                                                                         sql,
                                                                         org.springframework
                                                                                 .transaction.support
                                                                                 .TransactionSynchronizationManager
                                                                                 .isActualTransactionActive(),
                                                                         connection
                                                                                 .getTransactionIsolation(),
                                                                         connection.isReadOnly()));
                                                     var result = m.invoke(statement, a);
                                                     if (m.getName().equals("executeQuery"))
                                                         afterQuery.accept(sql);
                                                     return result;
                                                 } catch (
                                                         java.lang.reflect.InvocationTargetException
                                                                 e) {
                                                     if (e.getCause()
                                                             instanceof
                                                             java.sql.SQLException failure)
                                                         sqlState.set(failure.getSQLState());
                                                     throw e.getCause();
                                                 }
                                             });
                                 }
                                 return value;
                             } catch (java.lang.reflect.InvocationTargetException e) {
                                 throw e.getCause();
                             }
                         });
     }
 
     static void latch(CountDownLatch value) {
         try {
             if (!value.await(5, TimeUnit.SECONDS)) throw new AssertionError("finite latch timeout");
         } catch (InterruptedException e) {
             Thread.currentThread().interrupt();
             throw new AssertionError(e);
         }
     }
 
