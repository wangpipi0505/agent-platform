         }
 
         @Bean
         DataSource dataSource() {
             return ds;
         }
 
         @Bean
         JdbcTemplate jdbc() {
             return db;
         }
 
         @Bean
         TraceStore trace() {
             return trace = new TraceStore(db, new DataSourceTransactionManager(ds), iam.clock());
         }
 
         @Bean
         RuntimeClients clients() {
             return clients =
                     new RuntimeClients(
                             iam.config("engine"), engine, "http://127.0.0.1:" + appPort, true) {
                         @Override
                         public JsonNode get(String s, String p, Actor a) {
                             legacyCalls.incrementAndGet();
                             return super.get(s, p, a);
                         }
 
                         @Override
                         public JsonNode post(String s, String p, Object b, Actor a) {
                             legacyCalls.incrementAndGet();
                             return super.post(s, p, b, a);
                         }
                     };
         }
 
         @Bean
         RunScheduler scheduler(TraceStore t) {
             return scheduler =
                     new RunScheduler(new RunScheduleRepository(t, true), 2, 1, 10000, 90000, 1000) {
                         @Override
                         public void created(long id, Admission admission) {
                             createdCalls.incrementAndGet();
                             beforeCreated.run();
                             super.created(id, admission);
                             afterCreated.run();
                         }
                     };
         }
 
         @Bean
         RunService service(TraceStore t, RuntimeClients c, RunScheduler s) {
             return service =
                     new RunService(
                             t,
                             c,
                             new FlowDriver(t, null),
                             null,
                             s,
                             new RunAuthority(
                                     new RunAuthorityStore(ds, iam.clock()),
                                     engine,
                                     iam.clock(),
                                     Duration.ofSeconds(3)),
                             new RunAuthorityStore(ds, iam.clock()),
                             iam.clock());
         }
 
         @Bean
         ApprovalService approvals(TraceStore t) {
             return new ApprovalService(t);
         }
 
         @Bean
         ChunkBus chunks() {
             return new ChunkBus();
         }
 
         @Bean(destroyMethod = "close")
         JwtDecoder decoder() {
             return new TrustedJwtDecoder(iam.config("engine"), iam.clock(), true);
         }
 
         @Bean
         ServiceAuthorization authorization() {
             return new ServiceAuthorization("engine", new ServiceRoutePolicy(), engine);
         }
 
         @Bean
         SecurityFilterChain security(HttpSecurity h, JwtDecoder d, ServiceAuthorization a)
                 throws Exception {
             return SecurityConfiguration.serviceSecurity(h, d, a);
         }
 
         @Bean
         org.springframework.web.servlet.handler.MappedInterceptor guard(ServiceAuthorization a) {
             return a.mappedInterceptor();
         }
 
         @Bean
         RouteCoverageVerifier coverage(List<RequestMappingInfoHandlerMapping> mappings) {
             return new RouteCoverageVerifier("engine", new ServiceRoutePolicy(), mappings);
         }
     }
 
