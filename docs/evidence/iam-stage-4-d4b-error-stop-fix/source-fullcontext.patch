   if (id)
     nodes[id] =
       (
         {
           NODE_STARTED: "RUNNING",
           NODE_FINISHED: "SUCCEEDED",
           NODE_FAILED: "FAILED",
           WAITING_STEP: "WAITING_STEP",
           WAITING_APPROVAL: "WAITING_APPROVAL",
