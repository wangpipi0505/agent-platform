+            for(var keys:List.of(List.<RSAKey>of(),List.of(f.policyKey),List.of(f.policyKey.toPublicJWK(),f.policyKey.toPublicJWK()),List.of(f.policyKey.toPublicJWK(),f.key.toPublicJWK(),f.portalKey.toPublicJWK())))
