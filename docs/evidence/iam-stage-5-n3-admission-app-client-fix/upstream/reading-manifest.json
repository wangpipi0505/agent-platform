  "actualReadMechanisms": [
    "HttpClientBuilder 833-834, 899-963: context castOrCreate, LAST processing, Protocol→Connect→Main chain",
    "ConnectExec 110-203: endpoint lease/connect/upgradeTls before chain.proceed",
    "MainClientExec 99-143, 176-188: processor before execute and RuntimeException discard/rethrow",
    "InternalHttpClient 145-188: same context adaptor into ExecChain.Scope and runtime exception propagation",
    "HttpClientContext 151-188: existing typed context retained, independent create",
    "InternalExecRuntime 213-240: cancellation check before endpoint.execute, no proof awareness",
    "CloseableHttpClient 238-264: context overload response handler and response closing",
    "Private RetainedAuthorization requireVerified in common source103-127: private verificationClock, no ThreadLocal"
  ],
  "productionReference": "Checks precede GET wire-write but are not atomic revocation of already-sent bytes; no cross-thread requireBound or public VA rebinding",
