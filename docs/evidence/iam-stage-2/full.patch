+        c.put("resource",Map.of("kind","origin","id","test-origin","version_digest","v1"));
+        c.put("authority_mode",workload?"workload":"delegated");
+        if(workload){c.put("sub","gateway");for(var k:List.of("tenant_id","roles","attributes"))c.remove(k);}
