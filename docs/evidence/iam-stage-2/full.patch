+                return Jwt.withTokenValue(token).headers(h->h.putAll(jwt.getHeaders())).claims(c->{
+                    c.putAll(jwt.getClaims());c.put("roles",mapped.actor().roles());c.put("attributes",mapped.actor().attributes());
