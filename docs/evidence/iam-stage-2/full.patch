+            var body=exchange.getRequestBody().readNBytes(4096);
+            exchange.sendResponseHeaders(200,body.length);
+            try(var out=exchange.getResponseBody()){out.write(body);}exchange.close();
+        });
+        server.createContext("/decision", exchange -> {
+            var body=exchange.getRequestBody().readNBytes(4096);
+            exchange.sendResponseHeaders(200,body.length);
+            try(var out=exchange.getResponseBody()){out.write(body);}exchange.close();
+        });
