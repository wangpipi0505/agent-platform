+                var mainTicket=gateway.exchange(source,main);assertThat(mainTicket.operation().grantRef()).isNotEqualTo(proof.delegation().value());assertThat(mainTicket.operation().expiresAt()).isEqualTo(proof.operation().expiresAt());
