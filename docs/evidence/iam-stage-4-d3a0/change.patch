+
+    @Test void fullBodyDeadlineCancelsARealStalledHttpResponse(){try(var client=client()){
+        stall=true;long start=System.nanoTime();assertThatThrownBy(()->client.lookup(source,subject,"Demo")).isInstanceOf(PlatformException.class);
+        assertThat(Duration.ofNanos(System.nanoTime()-start)).isLessThan(Duration.ofSeconds(4));assertThat(hits).hasValue(1);
+    }}
+    @Test void missingDuplicateTrailingAndOutOfRangeFieldsCannotBecomeAResource(){try(var client=client()){
+        for(String invalid:List.of(valid().replace("\"versionId\":17,",""),valid().replace("\"versionNo\":3","\"versionNo\":2147483648"),valid().replace("\"versionId\":17","\"versionId\":9223372036854775808"),valid().replace("\"versionNo\":3","\"versionNo\":3.0"),valid().replace("\"appCode\":\"Demo\"","\"appCode\":false"),valid().replace("\"data\":{","\"data\":{\"appCode\":\"Demo\","),valid()+" {}",valid().replace("\"code\":\"OK\"","\"code\":\"ERROR\""))){
+            response=invalid;assertThatThrownBy(()->client.lookup(source,subject,"Demo")).isInstanceOf(PlatformException.class);
+        }
+    }}
+    @Test void subjectMismatchIsRejectedBeforeAnyAppSend(){try(var client=client()){
+        assertThatThrownBy(()->client.lookup(source,new SubjectKey("other-tenant","alice"),"Demo")).isInstanceOf(PlatformException.class);assertThat(hits).hasValue(0);
