+    }
+    @AfterEach void close(){if(server!=null)server.stop(0);if(serverThreads!=null)serverThreads.shutdownNow();if(gateway!=null)gateway.close();if(fixture!=null)fixture.close();}
+    URI origin(){return URI.create("http://127.0.0.1:"+server.getAddress().getPort());}
+    PublishedMetadataClient client(){return new PublishedMetadataClient(origin(),gateway,true);}
+    String valid(){return Json.canonical(ApiResponse.ok(Map.of("appCode","Demo","versionId",17,"versionNo",3,"versionSha256",Digest.sha256("stored"))));}
