                         "schemas",
                         schemas,
                         "securitySchemes",
                         Map.of(
                                 "bearerAuth",
                                 Map.of("type", "http", "scheme", "bearer", "bearerFormat", "JWT"))),
                 "security",
                 List.of(Map.of("bearerAuth", List.of())));
     }
 
     @GetMapping(value = "/assistant.js", produces = "text/javascript")
     public byte[] assistant() throws IOException {
