             var exchangeExpiry=Collections.min(List.of(AuthorityProtocol.time(exchange.current(),"exp"),ticket.expiresAt(),ticket.operation().expiresAt(),AuthorityProtocol.time(initial.claims(),"grant_expires_at")));
