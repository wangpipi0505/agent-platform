+    static final class Child implements AutoCloseable {
+        final Process process;
+        final Path file;
+        final Thread collector;
+        volatile Throwable error;
+        Child(Process process, Path file, int limit) {
+            this.process = process;
+            this.file = file;
+            collector = Thread.ofPlatform().daemon().start(() -> {
+                try (var in = process.getInputStream(); var out = Files.newOutputStream(file)) {
+                    byte[] buffer = new byte[4096]; int n, total = 0;
+                    while ((n = in.read(buffer)) != -1) {
+                        total += n;
+                        if (total > limit) throw new IOException("child output limit");
+                        out.write(buffer, 0, n);
+                    }
+                } catch (Throwable e) { error = e; process.destroyForcibly(); }
+            });
+        }
+        void await(int seconds) throws Exception {
+            assertTrue(process.waitFor(seconds, TimeUnit.SECONDS), "child deadline");
+            collector.join(2000);
+            assertFalse(collector.isAlive());
+            assertNull(error);
+            persistExit();
+        }
+        String output() throws IOException { return Files.exists(file) ? new String(Files.readAllBytes(file), StandardCharsets.UTF_8) : ""; }
+        public void close() throws Exception {
+            if (process.isAlive()) process.destroyForcibly();
+            assertTrue(process.waitFor(3, TimeUnit.SECONDS), "child must actually exit");
+            collector.join(2000);
+            assertFalse(collector.isAlive());
+            persistExit();
+        }
+        void persistExit() throws IOException {
+            Path exit=file.resolveSibling(file.getFileName()+".exit.properties");
+            if(!Files.exists(exit)){
+                var p=new Properties();p.setProperty("pid",Long.toString(process.pid()));p.setProperty("exitCode",Integer.toString(process.exitValue()));
+                p.setProperty("alive",Boolean.toString(process.isAlive()));p.setProperty("collectorAlive",Boolean.toString(collector.isAlive()));store(exit,p);
