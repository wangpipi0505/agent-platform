+        fixture.peer.inputSchema = s;
+        assertEquals(
+                7,
+                assertDoesNotThrow(() -> fixture.invoke(false)).structured().path("value").asInt());
+        assertEquals(0, fixture.peer.schemaReads.get());
+    }
