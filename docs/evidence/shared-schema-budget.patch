+                                                        Map.of(
+                                                                "type", "string", "$anchor",
+                                                                "item")),
+                                                "allOf",
+                                                List.of(
+                                                        Map.of("$ref", "#/$defs/a~1b~0c"),
+                                                        Map.of("$ref", "#item"))))));
