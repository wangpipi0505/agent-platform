+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void outputWorkRejectionPreservesReadAndWriteSemantics(boolean write) {
+        fixture.peer.output =
+                cn.agentplatform.common.Json.write(Map.of("value", "a".repeat(100000)));
